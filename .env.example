# Server-side only. Copy to .env.local and enter values there, never in chat.
# Never use VITE_ names for these credentials. .env.local is ignored by Git.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Server-only exact frontend origins, comma-separated. Never use a wildcard.
# Example for a Pages project: https://your-account.github.io (no repo path).
SPOTIFY_ALLOWED_ORIGINS=

# Public frontend build setting for static hosting such as GitHub Pages.
# Exact HTTPS endpoint, e.g. https://your-proxy.vercel.app/api/spotify
# No credentials, query parameters, or fragment. Empty uses local /api/spotify.
VITE_SPOTIFY_PROXY_URL=
